{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Meridian Domain Events",
  "type": "object",
  "definitions": {
    "DeviceCreated": {
      "type": "object",
      "required": ["eventId", "eventType", "deviceId", "payload", "timestamp"],
      "properties": {
        "eventId": {"type": "string", "format": "uuid"},
        "eventType": {"const": "DeviceCreated"},
        "deviceId": {"type": "string", "format": "uuid"},
        "payload": {
          "type": "object",
          "required": ["hostname", "ipAddress", "siteId", "deviceType"],
          "properties": {
            "hostname": {"type": "string"},
            "ipAddress": {"type": "string", "format": "ipv4"},
            "macAddress": {"type": "string"},
            "siteId": {"type": "string", "format": "uuid"},
            "deviceType": {"type": "string", "enum": ["router", "switch", "firewall", "ap", "server"]},
            "vendor": {"type": "string"},
            "model": {"type": "string"},
            "serialNumber": {"type": "string"},
            "firmwareVersion": {"type": "string"}
          }
        },
        "timestamp": {"type": "string", "format": "date-time"}
      }
    },
    "DeviceUpdated": {
      "type": "object",
      "required": ["eventId", "eventType", "deviceId", "payload", "timestamp"],
      "properties": {
        "eventId": {"type": "string", "format": "uuid"},
        "eventType": {"const": "DeviceUpdated"},
        "deviceId": {"type": "string", "format": "uuid"},
        "payload": {
          "type": "object",
          "properties": {
            "changedFields": {"type": "array", "items": {"type": "string"}},
            "previousValues": {"type": "object"},
            "newValues": {"type": "object"}
          }
        },
        "timestamp": {"type": "string", "format": "date-time"}
      }
    },
    "DeviceDeleted": {
      "type": "object",
      "required": ["eventId", "eventType", "deviceId", "timestamp"],
      "properties": {
        "eventId": {"type": "string", "format": "uuid"},
        "eventType": {"const": "DeviceDeleted"},
        "deviceId": {"type": "string", "format": "uuid"},
        "timestamp": {"type": "string", "format": "date-time"}
      }
    },
    "SiteCreated": {
      "type": "object",
      "required": ["eventId", "eventType", "siteId", "payload", "timestamp"],
      "properties": {
        "eventId": {"type": "string", "format": "uuid"},
        "eventType": {"const": "SiteCreated"},
        "siteId": {"type": "string", "format": "uuid"},
        "payload": {
          "type": "object",
          "required": ["name", "latitude", "longitude"],
          "properties": {
            "name": {"type": "string"},
            "description": {"type": "string"},
            "building": {"type": "string"},
            "rack": {"type": "string"},
            "latitude": {"type": "number"},
            "longitude": {"type": "number"},
            "timezone": {"type": "string"}
          }
        },
        "timestamp": {"type": "string", "format": "date-time"}
      }
    },
    "ThreatDetected": {
      "type": "object",
      "required": ["eventId", "eventType", "deviceId", "payload", "timestamp"],
      "properties": {
        "eventId": {"type": "string", "format": "uuid"},
        "eventType": {"const": "ThreatDetected"},
        "deviceId": {"type": "string", "format": "uuid"},
        "payload": {
          "type": "object",
          "required": ["eventType", "severity", "description"],
          "properties": {
            "eventType": {"type": "string", "enum": ["brute_force", "port_scan", "config_change", "anomaly"]},
            "severity": {"type": "string", "enum": ["critical", "high", "medium", "low"]},
            "description": {"type": "string"},
            "sourceIp": {"type": "string", "format": "ipv4"},
            "details": {"type": "object"}
          }
        },
        "timestamp": {"type": "string", "format": "date-time"}
      }
    },
    "ScanCompleted": {
      "type": "object",
      "required": ["eventId", "eventType", "scanId", "payload", "timestamp"],
      "properties": {
        "eventId": {"type": "string", "format": "uuid"},
        "eventType": {"const": "ScanCompleted"},
        "scanId": {"type": "string"},
        "payload": {
          "type": "object",
          "required": ["deviceId", "vulnerabilitiesFound", "scanType"],
          "properties": {
            "deviceId": {"type": "string", "format": "uuid"},
            "siteId": {"type": "string", "format": "uuid"},
            "vulnerabilitiesFound": {"type": "integer"},
            "scanType": {"type": "string", "enum": ["quick", "full"]},
            "durationMs": {"type": "integer"},
            "vulnerabilities": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["cveId", "severity"],
                "properties": {
                  "cveId": {"type": "string"},
                  "severity": {"type": "string", "enum": ["critical", "high", "medium", "low"]},
                  "description": {"type": "string"},
                  "cvssScore": {"type": "number"},
                  "affectedPackage": {"type": "string"},
                  "fixedVersion": {"type": "string"}
                }
              }
            }
          }
        },
        "timestamp": {"type": "string", "format": "date-time"}
      }
    },
    "ComplianceCheckFailed": {
      "type": "object",
      "required": ["eventId", "eventType", "deviceId", "payload", "timestamp"],
      "properties": {
        "eventId": {"type": "string", "format": "uuid"},
        "eventType": {"const": "ComplianceCheckFailed"},
        "deviceId": {"type": "string", "format": "uuid"},
        "payload": {
          "type": "object",
          "required": ["policyId", "policyName", "severity"],
          "properties": {
            "policyId": {"type": "string"},
            "policyName": {"type": "string"},
            "severity": {"type": "string", "enum": ["critical", "high", "medium", "low"]},
            "details": {"type": "string"}
          }
        },
        "timestamp": {"type": "string", "format": "date-time"}
      }
    },
    "ConfigChanged": {
      "type": "object",
      "required": ["eventId", "eventType", "deviceId", "payload", "timestamp"],
      "properties": {
        "eventId": {"type": "string", "format": "uuid"},
        "eventType": {"const": "ConfigChanged"},
        "deviceId": {"type": "string", "format": "uuid"},
        "payload": {
          "type": "object",
          "required": ["changeType", "description"],
          "properties": {
            "changeType": {"type": "string", "enum": ["backup", "deploy", "diff", "rollback"]},
            "description": {"type": "string"},
            "changedBy": {"type": "string"},
            "configHash": {"type": "string"}
          }
        },
        "timestamp": {"type": "string", "format": "date-time"}
      }
    },
    "DiscoveryCompleted": {
      "type": "object",
      "required": ["eventId", "eventType", "siteId", "payload", "timestamp"],
      "properties": {
        "eventId": {"type": "string", "format": "uuid"},
        "eventType": {"const": "DiscoveryCompleted"},
        "siteId": {"type": "string", "format": "uuid"},
        "payload": {
          "type": "object",
          "required": ["devicesFound", "newDevices", "changedDevices"],
          "properties": {
            "devicesFound": {"type": "integer"},
            "newDevices": {"type": "integer"},
            "changedDevices": {"type": "integer"},
            "removedDevices": {"type": "integer"},
            "durationMs": {"type": "integer"}
          }
        },
        "timestamp": {"type": "string", "format": "date-time"}
      }
    }
  },
  "oneOf": [
    {"$ref": "#/definitions/DeviceCreated"},
    {"$ref": "#/definitions/DeviceUpdated"},
    {"$ref": "#/definitions/DeviceDeleted"},
    {"$ref": "#/definitions/SiteCreated"},
    {"$ref": "#/definitions/ThreatDetected"},
    {"$ref": "#/definitions/ScanCompleted"},
    {"$ref": "#/definitions/ComplianceCheckFailed"},
    {"$ref": "#/definitions/ConfigChanged"},
    {"$ref": "#/definitions/DiscoveryCompleted"}
  ]
}